 "references": [],
 "narration": [
  {
   "at": 0,
   "say": "Bdo asks; the request becomes a task in a queue.",
   "focus": [
    "req",
    "queued"
   ]
  },
  {
   "at": 1500,
   "say": "A seat claims it and gets a worktree and branch of its own.",
   "focus": [
    "claimed",
    "tree"
   ]
  },
  {
   "at": 3000,
   "say": "Commits cross into GitHub only through the broker.",
   "focus": [
    "commits",
    "gh-push",
    "pr"
   ]
  },
  {
   "at": 4500,
   "say": "Checks pass, the opening seat merges, and the closure seat observes the landing.",
   "focus": [
    "checks",
    "merged",
    "landing"
   ]
  },
  {
   "at": 6000,
   "say": "A blocked task names who it waits on; an idle tree folds; abandoned work still gets a tombstone.",
   "focus": [
    "blocked",
    "folded",
    "abandoned",
    "tomb"
   ]
  }
 ]
}