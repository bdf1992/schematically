{
  "schema": "soveraeign.schematic/document@0.1",
  "id": "swarm-platform",
  "revision": 0,
  "meta": {
    "title": "01 \u2014 Participants and the authoritative platform",
    "status": "PROPOSED \u2014 architecture for review; no live execution",
    "notes": [
      "Participants include humans, controllers, workers, and reviewers. Models and clients are replaceable.",
      "All participant queries and commands enter service ports. Only services have custody of authoritative data.",
      "The kernel is shared contract evaluation enforced by each service; it need not be a single deployment.",
      "Commit state and its event record atomically within the owning service. Cross-service effects require recorded outcomes.",
      "Observation delivery is filtered by identity, authority, relevance, and freshness. Messages do not grant authority.",
      "Replay reconstructs committed history using recorded outcomes and versioned rules; it does not regenerate identical model decisions."
    ],
    "source": "https://github.com/bdf1992/schematically",
    "timeScale": 0
  },
