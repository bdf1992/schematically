{
  "schema": "soveraeign.schematic/document@0.1",
  "id": "workengine-sample",
  "revision": 0,
  "meta": {
    "title": "Work Engine map, sample: five records, three surfaces, one migration, one port",
    "description": "A small sample of the Work Engine map, authored from gapmap.json (read 2026-09-27). Records are hold cards in colour C1, surfaces are act cards in colour C2, work items are colour C3. Each card's subtitle names its kind and its status. See GAPS.md for what the model could not say directly."
  },
  "legend": {
    "names": {"C1": "Record", "C2": "Surface", "C3": "Work item"}
  },
  "components": [
    {"id": "records", "symbolId": "plane", "x": 600, "y": 400,
     "form": {"dimension": 2, "regions": {"interior": {"state": "open"}},
              "section": {"lines": [{"id": "L0"}], "bands": [], "core": {"fill": "space"}}},
     "config": {"label": "Records", "colorSlot": 6,
                "presentation": {"graphic": {"kind": "none"}, "labelMode": "boundary", "size": {"w": 1200, "h": 640}}}},

    {"id": "rec-mig-in", "symbolId": "point", "x": 0, "y": 420,
     "canvasId": "canvas:component:records", "parentId": "records",
     "placement": {"kind": "edge", "hostId": "records", "side": "left", "t": 0.53125},
     "config": {"label": "", "ports": {"out": {"face": "both"}}}},
    {"id": "rec-port-in", "symbolId": "point", "x": 1200, "y": 240,
     "canvasId": "canvas:component:records", "parentId": "records",
     "placement": {"kind": "edge", "hostId": "records", "side": "right", "t": 0.25},
     "config": {"label": "", "ports": {"out": {"face": "both"}}}},
    {"id": "rec-decl-out", "symbolId": "point", "x": 1200, "y": 580,
     "canvasId": "canvas:component:records", "parentId": "records",
     "placement": {"kind": "edge", "hostId": "records", "side": "right", "t": 0.78125},
     "config": {"label": "", "ports": {"out": {"face": "both"}}}},

    {"id": "contribution", "symbolId": "hold", "x": 160, "y": 240,
     "canvasId": "canvas:component:records", "parentId": "records",
     "config": {"label": "Contribution", "subtitle": "Record · missing", "colorSlot": 6,
                "presentation": {"size": {"w": 220, "h": 140}}}},
    {"id": "anchor", "symbolId": "hold", "x": 540, "y": 240,
     "canvasId": "canvas:component:records", "parentId": "records",
     "config": {"label": "Anchor", "subtitle": "Record · missing", "colorSlot": 6,
                "presentation": {"size": {"w": 220, "h": 140}}}},
    {"id": "recording", "symbolId": "hold", "x": 960, "y": 240,
     "canvasId": "canvas:component:records", "parentId": "records",
     "config": {"label": "Recording", "subtitle": "Record · partial", "colorSlot": 6,
                "presentation": {"size": {"w": 220, "h": 140}},
                "attachmentPoints": [
                  {"id": "tracks-in", "side": "right", "t": 0.5, "flow": "in", "label": "Tracks",
                   "channels": [{"id": "main"}, {"id": "video"}, {"id": "event"}, {"id": "narration"}]}]}},
    {"id": "case", "symbolId": "hold", "x": 540, "y": 420,
     "canvasId": "canvas:component:records", "parentId": "records",
     "config": {"label": "Case", "subtitle": "Record · exists", "colorSlot": 6,
                "presentation": {"size": {"w": 220, "h": 140}}}},
    {"id": "surface-registration", "symbolId": "hold", "x": 540, "y": 600,
     "canvasId": "canvas:component:records", "parentId": "records",
     "config": {"label": "Surface registration", "subtitle": "Record · partial", "colorSlot": 6,
                "presentation": {"size": {"w": 280, "h": 140}}}},

    {"id": "surfaces", "symbolId": "plane", "x": 1850, "y": 400,
     "form": {"dimension": 2, "regions": {"interior": {"state": "open"}},
              "section": {"lines": [{"id": "L0"}], "bands": [], "core": {"fill": "space"}}},
     "config": {"label": "Surfaces", "colorSlot": 7,
                "presentation": {"graphic": {"kind": "none"}, "labelMode": "boundary", "size": {"w": 500, "h": 640}}}},

    {"id": "sur-port-out", "symbolId": "point", "x": 1600, "y": 240,
     "canvasId": "canvas:component:surfaces", "parentId": "surfaces",
     "placement": {"kind": "edge", "hostId": "surfaces", "side": "left", "t": 0.25},
     "config": {"label": "", "ports": {"out": {"face": "both"}}}},
    {"id": "sur-decl-in", "symbolId": "point", "x": 1600, "y": 500,
     "canvasId": "canvas:component:surfaces", "parentId": "surfaces",
     "placement": {"kind": "edge", "hostId": "surfaces", "side": "left", "t": 0.65625},
     "config": {"label": "", "ports": {"out": {"face": "both"}}}},

    {"id": "web-booth", "symbolId": "act", "x": 1920, "y": 240,
     "canvasId": "canvas:component:surfaces", "parentId": "surfaces",
     "config": {"label": "Web booth", "subtitle": "Surface · partial", "colorSlot": 7,
                "presentation": {"size": {"w": 280, "h": 140}},
                "attachmentPoints": [
                  {"id": "tracks-out", "side": "left", "t": 0.25, "flow": "out", "label": "Tracks",
                   "channels": [{"id": "main"}, {"id": "video"}, {"id": "event"}, {"id": "narration"}]}]}},
    {"id": "delivery-broker", "symbolId": "act", "x": 1920, "y": 420,
     "canvasId": "canvas:component:surfaces", "parentId": "surfaces",
     "config": {"label": "Delivery broker", "subtitle": "Surface · exists", "colorSlot": 7,
                "presentation": {"size": {"w": 280, "h": 140}}}},
    {"id": "foundry-render-engine", "symbolId": "act", "x": 1920, "y": 600,
     "canvasId": "canvas:component:surfaces", "parentId": "surfaces",
     "config": {"label": "Foundry render engine", "subtitle": "Surface · missing", "colorSlot": 7,
                "presentation": {"size": {"w": 280, "h": 140}}}},

    {"id": "migration", "symbolId": "gate", "x": -560, "y": 420,
     "config": {"label": "Continuity records move from JSON files to a transactional SQLite store",
                "subtitle": "Migration · proposed", "colorSlot": 8,
                "presentation": {"size": {"w": 640, "h": 220},
                                 "text": "Waits on Bdo amending rule R-29 (decision D1)"}}},

    {"id": "port-web-booth-recording", "symbolId": "one-way", "x": 1320, "y": 240,
     "canvasId": "canvas:wire:w-port-global",
     "placement": {"kind": "wire", "wireId": "w-port-global", "t": 0.3},
     "config": {"label": "Web booth feeds Recording", "subtitle": "Port · partial", "colorSlot": 8}}
  ],
  "wires": [
    {"id": "w-case-recording", "a": "case", "aSide": "out", "b": "recording", "bSide": "in",
     "canvasId": "canvas:component:records", "config": {"label": "case owns recordings"}},
    {"id": "w-anchor-recording", "a": "anchor", "aSide": "out", "b": "recording", "bSide": "in",
     "canvasId": "canvas:component:records", "config": {"label": "points into"}},
    {"id": "w-contribution-anchor", "a": "contribution", "aSide": "out", "b": "anchor", "bSide": "in",
     "canvasId": "canvas:component:records", "config": {"label": "anchored at"}},

    {"id": "w-declares-exit", "a": "surface-registration", "aSide": "out", "b": "rec-decl-out", "bSide": "out",
     "canvasId": "canvas:component:records", "config": {"label": "declares"}},
    {"id": "w-declares-global", "a": "rec-decl-out", "aSide": "out", "b": "sur-decl-in", "bSide": "out",
     "canvasId": "canvas:global", "config": {"label": "declares"}},
    {"id": "w-declares-web-booth", "a": "sur-decl-in", "aSide": "out", "b": "web-booth", "bSide": "in",
     "canvasId": "canvas:component:surfaces", "config": {"label": "declares"}},
    {"id": "w-declares-delivery-broker", "a": "sur-decl-in", "aSide": "out", "b": "delivery-broker", "bSide": "in",
     "canvasId": "canvas:component:surfaces", "config": {"label": "declares"}},
    {"id": "w-declares-foundry", "a": "sur-decl-in", "aSide": "out", "b": "foundry-render-engine", "bSide": "in",
     "canvasId": "canvas:component:surfaces", "config": {"label": "declares"}},

    {"id": "w-moves-global", "a": "migration", "aSide": "out", "b": "rec-mig-in", "bSide": "out",
     "canvasId": "canvas:global", "config": {"label": "moves"}},
    {"id": "w-moves-case", "a": "rec-mig-in", "aSide": "out", "b": "case", "bSide": "in",
     "canvasId": "canvas:component:records", "config": {"label": "moves"}},

    {"id": "w-port-exit", "a": "web-booth", "aSide": "tracks-out", "b": "sur-port-out", "bSide": "out",
     "canvasId": "canvas:component:surfaces", "config": {"label": "tracks"}},
    {"id": "w-port-global", "a": "sur-port-out", "aSide": "out", "b": "rec-port-in", "bSide": "out",
     "canvasId": "canvas:global", "config": {"label": "video · event · narration"}},
    {"id": "w-port-enter", "a": "rec-port-in", "aSide": "out", "b": "recording", "bSide": "tracks-in",
     "canvasId": "canvas:component:records", "config": {"label": "tracks"}}
  ],
  "references": []
}
