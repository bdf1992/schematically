  "document": {
    "schema": "soveraeign.schematic/document@0.1",
    "id": "workstation-fraktal",
    "revision": 1,
    "meta": {
      "title": "The fraktal: one form at every level, drawn from its code model",
      "description": "Generated from tools/fraktal.py, where the requirements R1 to R9 are checks; the model passes all nine and each check reports a break made for it. Nine Knodes at −1, 0, +1; twelve Kords at one seam each, every one with a drive and an echo strand; four Korners at two seams; the Kore opened to show the same nine inside. The shell has a Knode's eight ports, each reaching the three Knodes on its edge, so the nine are one Knode. A strand labelled proposed is not in Bdo's cell.sov. Import counts are the kernel's code at structure digest 1636e3044cf94031: what runs along each Kord, and what crosses each Korner against the rule.",
      "updatedAt": "2026-10-10T04:37:56.976Z"
    },
