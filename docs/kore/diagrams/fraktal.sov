{
 "schema": "soveraeign.schematic/document@0.1",
 "id": "workstation-fraktal",
 "revision": 0,
 "notation": "fraktal",
 "meta": {
  "title": "The fraktal: nine Knodes, twelve Kords, four Korners, one shell",
  "description": "A solid edge is in your tile drawing. A dashed edge is something the model adds or only partly finds there: the shell, the four buses, the nine inside the Kore, and 6 of the 12 Kords, which lack a strand you have not drawn. A faded dashed edge is open: what a Korner is for. Blue, pink and olive are the three layers; teal is a Kord or a bus. Each Knode says what it holds in your words and how much kernel code is filed there today. Positions run −1, −0, 0, +0, +1 on both axes: Knodes sit at −1, 0, +1 and Kords at the seams −0 and +0. Generated from tools/fraktal.py, where 8 of 8 requirements hold on the model; three of them are checked only in part (see exports/fraktal-check.md)."
 },
 "legend": {
  "names": {
   "C1": "Layer +1 Purpose",
   "C2": "Layer 0 Dynamics",
   "C3": "Layer −1 Foundation",
   "C4": "Kord or bus",
   "C5": "Korner"
  }
 },
