{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOV Schematic",
  "version": "0.1.0",
  "identifier": "com.soveraeign.schematic",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SOV Schematic",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "fileAssociations": [
      {
        "ext": ["sov"],
        "description": "SOV Schematic document",
        "role": "Editor"
      },
      {
        "ext": ["sovpak"],
        "description": "SOV Schematic package",
        "role": "Editor"
      }
    ]
  }
}
