{
  "schema": "soveraeign.schematic/document@0.1",
  "id": "swarm-commons",
  "revision": 0,
  "meta": {
    "title": "03 \u2014 Collaboration through governed services",
    "status": "PROPOSED \u2014 architecture for review; no live execution",
    "notes": [
      "Contributors and reviewers are participants operating the same platform. Discovery may be subscription-driven or explicitly assigned.",
      "Publish problems, inspect evidence, reserve work, submit versioned artifacts, review, and settle through services.",
      "Claims are atomic reservations with deadlines and fencing. An expired worker cannot overwrite a newer owner.",
      "A review attaches evidence; acceptance is a separately authorized service transition. Reputation never grants authority by itself.",
      "Accepted work and unresolved findings become discoverable for later participants. Disagreement can produce revision or an explicit unresolved outcome.",
      "A participant may represent a nested team. Child authority and resources stay within the parent allocation, with traceable outcomes."
    ],
    "source": "https://github.com/bdf1992/schematically",
    "timeScale": 0,
    "originalLabels": {
      "contributor": "Contributor / team",
      "reviewer": "Reviewer / witness",
      "commons": "Shared collaboration services",
      "proposal": "Publish",
      "review-input": "Review",
      "feed": "Discover",
      "work": "Published work",
      "claim": "Claim / reserve",
      "artifact": "Versioned artifact",
      "review": "Review evidence",
      "accept": "Accept / settle",
      "discovery": "Findings / discovery"
    },
    "originalWireLabels": {
      "w1": "propose",
      "w2": "",
      "w3": "available",
      "w4": "submit",
      "w5": "inspect",
      "w6": "findings",
      "w7": "",
      "w8": "evidence",
      "w9": "publish outcome",
      "w10": "",
      "w11": "discover"
    },
    "presentationReview": "C5 requests/actions; C6 authority/control; C4 evidence; C1 breaker/refusal. Host and persistence fills use M1. Pin holds the host and authority/capacity reference geometry; drafts remain movable. Original captions retained in metadata; topology and authored geometry unchanged."
  },
