  "wires": [
    {
      "id": "k1",
      "a": "grant",
      "aSide": "out",
      "b": "permit",
      "bSide": "out",
      "canvasId": "canvas:global",
      "config": {
        "label": "scoped permission"
      }
    },
    {
      "id": "k2",
      "a": "permit",
      "aSide": "out",
      "b": "check",
      "bSide": "control",
      "canvasId": "canvas:component:svc"
    },
    {
      "id": "k3",
      "a": "req",
      "aSide": "out",
      "b": "ingress",
      "bSide": "out",
      "canvasId": "canvas:global",
      "config": {
        "label": "request"
      }
    },
    {
      "id": "k4",
      "a": "ingress",
      "aSide": "out",
      "b": "check",
      "bSide": "in",
      "canvasId": "canvas:component:svc"
    },
    {
      "id": "k5",
      "a": "check",
      "aSide": "out",
      "b": "store",
      "bSide": "in",
      "canvasId": "canvas:component:svc"
    },
    {
      "id": "k6",
      "a": "store",
      "aSide": "out",
      "b": "egress",
      "bSide": "out",
      "canvasId": "canvas:component:svc"
    },
    {
      "id": "k7",
      "a": "egress",
      "aSide": "out",
      "b": "log",
      "bSide": "in",
      "canvasId": "canvas:global",
      "config": {
        "forwardOperation": "write",
        "label": "record"
      }
    }
  ],
  "references": []
