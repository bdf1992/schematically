{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soveraeign.schematic/trace@0.1",
  "title": "SOV Schematic Trace (.sovtrace)",
  "description": "Documentation only: validation is the hand-written validateTrace in src/07-state-space.js. A run's trace (STATE-SPACE.md, Files; Runtime semantics (slice 1b)). The .sovtrace encoding is canonicalize(traceOf(run)): RFC 8785 JSON, sorted keys, no whitespace. MIME application/vnd.soveraeign.schematic-trace+json.",
  "type": "object",
  "required": [
    "format",
    "replayKey",
    "documentRevision",
    "budget",
    "through",
    "head",
    "ledger"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "soveraeign.schematic/trace@0.1"
    },
    "replayKey": {
      "$ref": "#/$defs/replayKey"
    },
    "documentRevision": {
      "type": "integer",
      "minimum": 0,
      "description": "a label for people; identity is replayKey.documentHash"
    },
    "budget": {
      "type": "integer",
      "minimum": 0,
      "description": "processed events allowed (inputs, arrivals, output changes); default 10000. Also carried in the start entry, so the chain covers it"
    },
    "through": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "the last tick processed, null before any; replay processes exactly the ticks up to it"
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "the hash of the last ledger entry; a truncated ledger fails against it"
    },
    "ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      },
      "description": "hash-chained; what a replay cannot recompute: the start entry (carrying {replayKey, budget}), an effects ledger handed in (right after start), each input (one given mid-run carries after), each stochastic order draw, each function handler's answer (result), each resume and each reconcile (with after). Replay applies an entry carrying after once the tick it names is processed, before the next"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "soveraeign.schematic/state-record@0.1"
      },
      "description": "optional: the derived records, for audit. When present, replay must reproduce them byte for byte; when absent, replay recomputes them. Ids are sr-<run>-<seq6>; time.sequence is their index"
    }
  },
  "$defs": {
    "replayKey": {
      "type": "object",
      "description": "Everything the fold depends on. Replay recomputes it from the document, the packs and this key's inputs and seed, and refuses with REPLAY_KEY_MISMATCH naming each differing field.",
      "required": [
        "documentId",
        "documentHash",
        "definitions",
        "runtimeVersion",
        "traceFormat",
        "inputs",
        "seed"
      ],
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "type": "string"
        },
        "documentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 over the canonical compactDocument() with revision and timestamps removed"
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^.+@[0-9]+$"
          },
          "description": "every resolved definition id@version, sorted"
        },
        "runtimeVersion": {
          "type": "string",
          "description": "state-space@1"
        },
        "traceFormat": {
          "const": "soveraeign.schematic/trace@0.1"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity",
              "point",
              "channel",
              "value",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "point": {
                "type": "string",
                "minLength": 1,
                "description": "the port id, as resolved (a compat id is stored as the port id)"
              },
              "channel": {
                "type": "string",
                "minLength": 1,
                "description": "default main"
              },
              "value": {
                "type": "boolean",
                "description": "binary channels only in slice 1b"
              },
              "at": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "description": "the registered inputs, in (at, entity, point, channel) order"
        },
        "seed": {
          "type": "string",
          "description": "default \"0\""
        }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "entity",
        "point",
        "channel",
        "value",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "type": "string",
          "minLength": 1,
          "description": "the port id, as resolved (a compat id is stored as the port id)"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "description": "default main"
        },
        "value": {
          "type": [
            "boolean",
            "object"
          ],
          "description": "a level (a boolean) on a binary channel; on channel message, {channel, payload, principal}"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "after": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "only on an input given mid-run (addInput): the tick processed before it was given. It is scheduled at max(at, after + 1), at 0 when after is null"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "tick",
        "entity",
        "messageId"
      ],
      "additionalProperties": false,
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "entity": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "result": {
          "description": "what the function answered, as JSON: {payload?, channel?, port?}, a list of them, {refuse}, {absorb} or null; an answer that is not JSON or carries a fraction is recorded as {refuse: reason}"
        },
        "error": {
          "type": "string",
          "description": "the message the function threw; exactly one of result and error is present"
        }
      },
      "description": "a function handler's answer, recorded when the run first reaches it; replay reads it and never calls the function"
    },
    "resume": {
      "type": "object",
      "required": [
        "after",
        "parkId",
        "decision"
      ],
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": [
            "integer",
            "null"
          ]
        },
        "parkId": {
          "type": "string",
          "description": "p-<message id>"
        },
        "decision": {
          "type": "string",
          "description": "approve continues at the card; anything else refuses the message"
        },
        "payload": {
          "description": "laid over an object message payload, else replacing it"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "reconcile": {
      "type": "object",
      "required": [
        "after",
        "effectKey",
        "confirmed"
      ],
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": [
            "integer",
            "null"
          ]
        },
        "effectKey": {
          "type": "string",
          "description": "<card id>:<business key>"
        },
        "confirmed": {
          "type": "boolean"
        },
        "result": {
          "description": "present when confirmed"
        }
      }
    },
    "effects": {
      "type": "object",
      "required": [
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "effects": {
          "type": "object",
          "description": "effect key to {key, node, status, at, messageId, result?, error?, confirmedAt?, reconciled?}, from an earlier run"
        }
      }
    },
    "draw": {
      "type": "object",
      "required": [
        "tick",
        "entity",
        "point",
        "channel",
        "paths",
        "order"
      ],
      "additionalProperties": false,
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "entity": {
          "type": "string"
        },
        "point": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the arrivals left after the declared Paths, sorted: the items drawOrder shuffles"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "drawOrder(seed, ['merge', tick, entity, point, channel], paths)"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "seq",
        "kind",
        "body",
        "prev",
        "hash"
      ],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "counts from 0"
        },
        "kind": {
          "enum": [
            "start",
            "input",
            "draw",
            "result",
            "resume",
            "reconcile",
            "effects"
          ]
        },
        "body": {
          "description": "start: {replayKey, budget}; input: one input; draw: one stochastic merge order; result: a function handler's answer; resume: a person's answer to a parked message; reconcile: the answer to an ambiguous effect; effects: an effects ledger handed in at start"
        },
        "prev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "the previous entry's hash; 64 zeros for the first"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256Hex(canonicalize({seq, kind, body, prev}))"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "start"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/start"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "input"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/input"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "draw"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/draw"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "result"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "resume"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/resume"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reconcile"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/reconcile"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "effects"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/effects"
              }
            }
          }
        }
      ]
    },
    "start": {
      "type": "object",
      "required": [
        "replayKey",
        "budget"
      ],
      "additionalProperties": false,
      "properties": {
        "replayKey": {
          "$ref": "#/$defs/replayKey"
        },
        "budget": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "the start entry body: equal to the trace's replayKey and budget"
    }
  }
}
